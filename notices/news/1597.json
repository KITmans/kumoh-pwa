00 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"331\" height=\"40\">\n            <p class=\"HStyle0\" align=\"center\"><span style=\"FONT-SIZE: 11pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;굴림&quot;\"></span><span style=\"FONT-SIZE: 11pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;굴림&quot;\"><font size=\"2\">&nbsp;&nbsp;&nbsp; 상호 언어교류를 위한 자유 스터디 활동</font></span></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"161\" height=\"40\">\n            <p class=\"HStyle0\" align=\"center\"><span style=\"FONT-SIZE: 11pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;굴림&quot;\"><font size=\"2\">&nbsp;30시간이상 활동의무</font></span></p>\n            </td>\n        </tr>\n        <tr>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"116\" height=\"57\">\n            <p class=\"HStyle0\" align=\"center\"><span style=\"FONT-SIZE: 11pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;굴림&quot;\"><font size=\"2\"><strong>&nbsp;생활지원</strong></font></span></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"331\" height=\"57\">\n            <p class=\"HStyle0\" align=\"center\"><font size=\"2\"><span style=\"FONT-SIZE: 11pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;굴림&quot;\">&nbsp;&nbsp;<font size=\"2\">&nbsp;유학생들이 본교생활에 잘 적응하도록<br>&nbsp;&nbsp;&nbsp;생활 중 </font></span></font><font size=\"2\"><span style=\"FONT-SIZE: 11pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;굴림&quot;\">어려운 점을 지원</span></font></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"161\" height=\"57\">\n            <p class=\"HStyle0\" align=\"center\"><font size=\"2\"><span style=\"FONT-SIZE: 11pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;굴림&quot;\">&nbsp;<font size=\"2\">&nbsp;1:1 또는 그룹내&nbsp;<br></font></span></font><span style=\"FONT-SIZE: 11pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;굴림&quot;\"><font size=\"2\">&nbsp;교류메이트 지정</font></span></p>\n            </td>\n        </tr>\n        <tr>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"116\" height=\"57\">\n            <p class=\"HStyle0\" align=\"center\"><span style=\"FONT-SIZE: 11pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;굴림&quot;\"><font size=\"2\">&nbsp;<strong>단체활동 참여</strong></font></span></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"331\" height=\"57\">\n            <p class=\"HStyle0\" align=\"center\"><font size=\"2\"><span style=\"FONT-SIZE: 11pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;굴림&quot;\">&nbsp;<font size=\"2\">교육원 주관 문화체험</font> <font size=
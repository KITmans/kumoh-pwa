d; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.7pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.7pt solid\" valign=\"middle\" width=\"123\" bgcolor=\"#ffffcc\" height=\"27\">\n            <p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;HY동녘B&quot;\">5월(19일)</span></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 1.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.7pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.7pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.7pt solid\" valign=\"middle\" width=\"162\" bgcolor=\"#feffcc\" height=\"27\">\n            <p class=\"HStyle0\" style=\"MARGIN-BOTTOM: 4pt; LINE-HEIGHT: 120%; TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 120%; FONT-FAMILY: &quot;HY동녘B&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;110,200</span></p>\n            </td>\n        </tr>\n        <tr>\n            <td style=\"BORDER-RIGHT: #000000 0.7pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.7pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.7pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.7pt solid\" valign=\"middle\" width=\"123\" bgcolor=\"#ffffcc\" height=\"27\">\n            <p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;HY동녘B&quot;\">6월(12일)</span></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 1.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.7pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.7pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.7pt solid\" valign=\"middle\" width=\"162\" bgcolor=\"#feffcc\" height=\"27\">\n            <p class=\"HStyle0\" style=\"MARGIN-BOTTOM: 4pt; LINE-HEIGHT: 120%; TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 120%; FONT-FAMILY: &quot;HY동녘B&quot;\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;69,600</span></p>\n            </td>\n        </tr>\n        <tr>\n            <td style=\"BORDER-RIGHT: #000000 0.7pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.7pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.7pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 1.4pt solid\" valign=\"middle\" width=\"123\" bgcolor=\"#ffffcc\" height=\"27\">\n            <p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;HY동녘B&quot;\">계</span></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 1.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.7pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.7pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 1.4pt solid\" valign=\"middle\" width=\"162\" bgcolor=\"#ffffcc\" height=\"27\">\n            <p class=\"HStyle0\" style=\"MARGIN-RIGHT: 7.8pt; TEXT-ALIGN: right\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: &quot;HY동녘B&quot;\">&nbsp;435,000</span></p>\n            </td>\n        </tr>\n    </tbody>\n</table>\n<p></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;6. 납부방법&nbsp;&nbsp;<br></span><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;가. 납부금융기관 : 시중은행, 농협, 우체국<br></span><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;나. 납부방법 : 통장입금 및 인터넷뱅킹 , 지로&nbsp;&nbsp;<br></span><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;- 무통장입금 및 인터넷뱅킹, 지로 입금시 필히 학생의 학번 및 이름으로 입금,&nbsp; 신입생,편입생은 수험번호 및 이름으로 입금</span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\"></span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;7. 교통카드 발급 안내&nbsp;<br></span><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;후원금을 입금한 영수증과 교통카드 보증금(10,000원)을 지참하여 학생회관 1층 학사서비스센터에서 교통카드를 발급 받아 통학버스 이용.&nbsp;</span><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">(교통카드 보증금 10,000원은 버스를 이용후(학기 말) 학사서비스센터에 카드를 반납하면 즉시 환불 조치)&nbsp;<br></span><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;※ 단, 통학버스 후원금 정기권 환불금액은 월권금액으로 환불함.</span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;8. 기타 문의사항은 054)478-7044&nbsp;&nbsp;&nbsp; </span></p>\n<p class=\"HStyle0\"><span style=\"FONT-FAMILY: &quot;한컴바탕&quot;\"><br></span></p>\n\t\t\t\t\t\n\t\t\t\t\t\n            "}

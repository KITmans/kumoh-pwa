 1,\n\"bf\": \"01DB2A9B4B31482000000029\",\n\"tb\": true,\n\"hi\": false,\n\"fi\": false,\n\"fa\": 0,\n\"ol\": 1417,\n\"or\": 1417,\n\"ot\": 1417,\n\"ob\": 1417\n},\n{\n\"ty\": 2,\n\"bf\": \"01DB2A9B4B31482000000029\",\n\"tb\": true,\n\"hi\": false,\n\"fi\": false,\n\"fa\": 0,\n\"ol\": 1417,\n\"or\": 1417,\n\"ot\": 1417,\n\"ob\": 1417\n}\n],\n\"mp\": [ ]\n}\n,\n\"01DB2A9B4B31482000000027\": {\n\"cc\": 2,\n\"ci\": 1668246628,\n\"ty\": 0,\n\"la\": 0,\n\"co\": 1,\n\"ss\": true,\n\"sg\": 0,\n\"lt\": 0,\n\"lw\": 0,\n\"lc\": 0,\n\"cs\": [ ]\n}\n},\n\"bi\": [ ],\n\"bidt\": { }\n}--></div><p></p><div class=\"txc-textbox\" style=\"border-style: solid; border-width: 1px; border-color: rgb(203, 203, 203); background-color: rgb(255, 255, 255); padding: 10px;\"><div class=\"txc-textbox\" style=\"border-style: double; border-width: 3px; border-color: rgb(121, 165, 228); background-color: rgb(219, 232, 251); padding: 10px;\"><p class=\"0\" style=\"mso-pagination:none;text-autospace:none;mso-padding-alt:0pt 0pt 0pt 0pt;\"><span lang=\"EN-US\" style=\"font-family: HY헤드라인M; letter-spacing: 0pt; font-size: 36pt;\">FAQ</span></p><p class=\"0\"><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\"><br></span></p><p class=\"0\" style=\"padding-top: 0px; font-family: 돋움;\"><span lang=\"EN-US\" style=\"letter-spacing: 0pt;\"><span lang=\"EN-US\" style=\"letter-spacing: 0pt;\"><span style=\"color: rgb(255, 0, 0);\">※ 1년호실</span><font face=\"함초롬바탕\"><span style=\"color: rgb(255, 0, 0);\">&nbsp;기존 거주자는 일반선발 시 자동신청되므로 납부기간</span><span style=\"color: rgb(255, 0, 0);\">&nbsp;내</span><span style=\"color: rgb(255, 0, 0);\">&nbsp;생활관비를 납부해야 탈락처리되지 않습니다.</span></font></span></span></p><p class=\"0\"></p><p class=\"0\" style=\"padding-top: 0px; font-family: 돋움;\"><span style=\"color: rgb(255, 0, 0);\">※ 1년호실 납부기간:&nbsp;</span><span style=\"font-family: 함초롬바탕; color: rgb(255, 0, 0);\">11/19(화) ~ 11/21</span><span style=\"font-family: 함초롬바탕; color: rgb(255, 0, 0);\">(목), 매일 10시 ~ 16시(일반선발 및 비일반실 연장과 동일)</span></p><p class=\"0\"><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\"><br></span></p><p class=\"0\"><span lang=\"EN-US\">  </span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">1. 2</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">학기에 거주하던 호실이 달라지나요</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">?</span></p><p class=\"0\"><span lang=\"EN-US\">     </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">☞ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">호실 변동 있습니다</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">.</span></p><p class=\"0\"><br></p><p class=\"0\">  <!--[if !supportEmptyParas]-->&nbsp;<span lang=\"EN-US\" style=\"letter-spacing: 0pt;\">2. 2</span><span style=\"font-family: 함초롬바탕;\">학기 또는 동계방학에 거주하던 호실이 달라지나요</span><span lang=\"EN-US\" style=\"letter-spacing: 0pt;\">?</span></p><p class=\"0\"><span lang=\"EN-US\">     </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">☞ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">관</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">, </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">호실 변동 있습니다</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">. 2</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">학기 퇴사일</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">(2024.12.21.(</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">토</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">) 10</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">시</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">)</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">에 모두 퇴실 후 </span></p><p class=\"0\"><span lang=\"EN-US\">        </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">당일</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">(12.23.) 14</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">시 선발된 관</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">, </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">호실을 원스톱서비스에서 확인 후 해당 호실로 입사합니다</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">.</span></p><p class=\"0\">  <!--[if !supportEmptyParas]-->&nbsp;<!--[endif]-->  <o:p></o:p></p><p class=\"0\"><span lang=\"EN-US\">  </span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">3. 2024</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">학년도 연장입사</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">(12.21.~12.24.)</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">는 언제 신청하나요</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">?</span></p><p class=\"0\"><span lang=\"EN-US\">     </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">☞ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">입사기간</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">: 2024.12.21.(</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">토</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">) 10:00 ~ 12.24.(</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">화</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">) 10:00 [4</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">일</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">]</span></p><p class=\"0\"><span lang=\"EN-US\">     </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">☞ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">신청기간</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">: 12</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">월 초</span></p><p class=\"0\"><span lang=\"EN-US\">     </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">☞ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">신청방법</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">: </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">원스톱서비스</span></p><p class=\"0\">  <!--[if !supportEmptyParas]-->&nbsp;<!--[endif]-->  <o:p></o:p></p><p class=\"0\"><span lang=\"EN-US\">  </span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">4. </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">계절학기 수강생만 동계방학 생활관 신청이 가능한가요</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">?</span></p><p class=\"0\"><span lang=\"EN-US\">     </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">☞ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">재학생이라면 모두 신청 가능하고</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">, </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">휴학생 중 계절학기 수강생</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">(</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">수강료 납부자</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">)</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">은 일반선발에&nbsp;</span><span style=\"font-family: 함초롬바탕;\">신청 가능합니다</span><span lang=\"EN-US\" style=\"letter-spacing: 0pt;\">.</span></p><p class=\"0\"><span lang=\"EN-US\">        </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">※ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">수업연한 초과자는 추가선발 때 신청 가능합니다</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">.(</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">일반선발 신청 시 탈락 처리</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">)</span></p><p class=\"0\">  <!--[if !supportEmptyParas]-->&nbsp;<!--[endif]-->  <o:p></o:p></p><p class=\"0\"><span lang=\"EN-US\">  </span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">5. </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">공고문에 나온 신청 기간 말고는 신청을 못하나요</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">?</span></p><p class=\"0\"><span lang=\"EN-US\">     </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">☞ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">네</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">, </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">신청기간 외에는 생활관 신청 및 식사변경이 불가합니다</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">.</span></p><p class=\"0\">  <!--[if !supportEmptyParas]-->&nbsp;<!--[endif]-->  <o:p></o:p></p><p class=\"0\"><span lang=\"EN-US\">  </span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">6. </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">룸메이트 자율 신청은 친구끼리 신청할 수 있는 건가요</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">?</span></p><p class=\"0\"><span lang=\"EN-US\">     </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">☞ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">네</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">, </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">같은 관</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">&amp;</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">호실 유형</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">(</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">푸름관</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">3</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">동 일반실끼리</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">, </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">오름관</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">2</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">동 기혼자실끼리</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">), </span></p><p class=\"0\"><span lang=\"EN-US\">        </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">같은 기간</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">(</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">방학</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">A, </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">방학</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">B)</span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">에 신청</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">, </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">선발되어 납부한 학생들끼리 신청 가능합니다</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">.</span></p><p class=\"0\">  <!--[if !supportEmptyParas]-->&nbsp;<!--[endif]-->  <o:p></o:p></p><p class=\"0\"><span lang=\"EN-US\">  </span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">7. </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">담당자 전화번호가 어떻게 되나요</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">?</span></p><p class=\"0\"><span lang=\"EN-US\">     </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">☞ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">선발 문의</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">: 054-478-7943</span></p><p class=\"0\"><span lang=\"EN-US\">     </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">☞ </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">생활관비 문의</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">: </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">푸름관비</span><span lang=\"EN-US\" style=\"mso-fareast-font-family:함초롬바탕;mso-font-width:100%;letter-spacing:0pt;mso-text-raise:0pt;\">: 7201, </span><span style=\"font-family:함초롬바탕;mso-fareast-font-family:함초롬바탕;\">오름관비 </span><span lang=\"EN-US\" style=\"
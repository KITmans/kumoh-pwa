   <p align=\"center\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">51</span></font></p>\n            </td>\n        </tr>\n        <tr>\n            <td width=\"70\" bgcolor=\"#ffffff\" height=\"23\">\n            <p align=\"center\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">경영학석사</span></font></p>\n            </td>\n            <td width=\"311\" bgcolor=\"#ffffff\" height=\"23\">\n            <p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">■테크노경영학과 </span></font></p>\n            </td>\n        </tr>\n    </tbody>\n</table>\n<p></p>\n<p align=\"justify\"><strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\"></span></font></strong>&nbsp;</p>\n<p align=\"justify\"><strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">4. </span></font><font face=\"굴림\" color=\"#ff1493\"><span style=\"FONT-SIZE: 10pt\">교육대학원 (5학기)</span></font></strong></p>\n<p align=\"justify\"><strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\"></span></font></strong></p>\n<table cellspacing=\"1\" cellpadding=\"3\" width=\"500\" align=\"center\" bgcolor=\"#999999\" border=\"0\">\n    <tbody>\n        <tr>\n            <td width=\"72\" bgcolor=\"#e5e5ff\" height=\"27\">\n            <p align=\"center\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">학 위</span></font></p>\n            </td>\n            <td width=\"33\" bgcolor=\"#e5e5ff\" height=\"27\">\n            <p align=\"center\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">구 분</span></font></p>\n            </td>\n            <td width=\"301\" bgcolor=\"#e5e5ff\" height=\"27\">\n            <p align=\"center\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">모 집 전 공 </span></font></p>\n            </td>\n            <td width=\"65\" bgcolor=\"#e5e5ff\" height=\"27\">\n            <p align=\"center\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">모집인원</span></font></p>\n            </td>\n        </tr>\n        <tr>\n            <td width=\"72\" bgcolor=\"#ffffff\" height=\"64\">\n            <p align=\"center\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">교육학석사</span></font></p>\n            </td>\n            <td width=\"33\" bgcolor=\"#ffffff\" height=\"64\">\n            <p align=\"center\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">야간</span></font></p>\n            </td>\n            <td width=\"301\" bgcolor=\"#ffffff\" height=\"64\">\n            <p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">■기계교육전공 &nbsp;&nbsp;■전자교육전공&nbsp;&nbsp;■컴퓨터교육전공</span></font></p>\n            <p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">■수학교육전공&nbsp;&nbsp; ■과학교육전공&nbsp;&nbsp;■영어교육전공 </span></font></p>\n            <p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">■국어교육전공 &nbsp;&nbsp;■사회교육전공&nbsp;&nbsp;■교육행정전공 </span></font></p>\n            </td>\n            <td width=\"65\" bgcolor=\"#ffffff\" height=\"64\">\n            <p align=\"center\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">61</span></font></p>\n            </td>\n        </tr>\n    </tbody>\n</table>\n<p></p>\n<p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\"></span></font>&nbsp;</p>\n<p align=\"justify\"><strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">Ⅲ. 지원자격 </span></font></strong></p>\n<p align=\"justify\"><strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">1. 박사과정 </span></font></strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">☞ 석사과정의 전공과 다른 학과에 지원하는 경우는 본 대학교 지원학과 </span></font></p>\n<p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;&nbsp;주임교수 추천서 첨부</span></font></p>\n<p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">&nbsp;&nbsp;가. 국내·외 대학원에서 석사학위 취득 또는 2009년 8월 취득예정자</span></font></p>\n<p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">&nbsp;&nbsp;나. 기타 법 령에 의하여 대학원 이상의 학력이 있다고 인정된 자 &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></font></p>\n<p align=\"justify\"><strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\"></span></font></strong>&nbsp;</p>\n<p align=\"justify\"><strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">2. 석사과정 </span></font></strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">☞ 학부의 전공과 관계없이 지원할 수 있음. </span></font></p>\n<p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">&nbsp;&nbsp;가. 국내·외 대학 졸업 또는 2009년 8월 졸업예정자 </span></font></p>\n<p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">&nbsp;&nbsp;나. 기타 법 령에 의하여 대학졸업 이상의 학력이 있다고 인정된 자</span></font></p>\n<p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">&nbsp;&nbsp;다.</span></font><strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\"> </span></font><u><font face=\"굴림\" color=\"#9932cc\"><span style=\"FONT-SIZE: 10pt\">교육대학원은 현직교직원 및 해당과목 교원자격증소지자에 한함.</span></font></u></strong></p>\n<p align=\"justify\"><strong><font color=\"#9932cc\"><font face=\"굴림\"><span style=\"FONT-SIZE: 10pt\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</span></font><u><font face=\"굴림\"><span style=\"FONT-SIZE: 10pt\">(교육행정전공은 제한없음)</span></font></u></font></strong></p>\n<p align=\"justify\"><strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\">&nbsp;&nbsp;&nbsp;&nbsp;★ 입시관련 문의 : 전화 (054)478-7014∼5, FAX (054)478-7020</span></font></strong></p>\n<p align=\"justify\"><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 10pt\"><span style=\"FONT-WEIGHT: bold; FONT-SIZE: 10pt; LINE-HEIGHT: 160%; FONT-FAMILY: 굴림\"><font face=\"굴림\" color=\"#ff1493\"></font></span>&nbsp;\n</span></font></p><p><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-WEIGHT: bold; FONT-SIZE: 10pt; LINE-HEIGHT: 160%; FONT-FAMILY: 굴림\"><font face=\"굴림\"><font color=\"#1e90ff\">&nbsp;<font face=\"굴림체\" size=\"3\">☞ </font></font><a href=\"http://www.kumoh.ac.kr/ipsi/graduate/graduate02_1.htm\"><font face=\"굴림체\"><font color=\"#1e90ff\" size=\"3\">입학안내 바로가기</font> </font></a></font></span></font></p><font face=\"굴림\" color=\"#494949\">\n<p>&nbsp;</p>\n<p>&nbsp;</p>\n</font><p></p>\n<p></p>\n<p></p>\n<p></p>\n<p></p>\n<p></p>\n<p align=\"center\"><strong><font face=\"굴림\" color=\"#494949\"><span style=\"FONT-SIZE: 12pt\">금오공과대학교 대학원장</span></font></strong></p>\n\t\t\t\t\t\n\t\t\t\t\t\n            "}

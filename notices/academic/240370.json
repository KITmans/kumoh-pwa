n{\n\"ty\": 2,\n\"bf\": \"01D66ED9051E51C000000016\",\n\"tb\": true,\n\"hi\": false,\n\"fi\": false,\n\"fa\": 0,\n\"ol\": 1417,\n\"or\": 1417,\n\"ot\": 1417,\n\"ob\": 1417\n}\n],\n\"mp\": [ ]\n}\n,\n\"01D66ED9051E51C000000012\": {\n\"cc\": 2,\n\"ci\": 1668246628,\n\"ty\": 0,\n\"la\": 0,\n\"co\": 1,\n\"ss\": true,\n\"sg\": 0,\n\"lt\": 0,\n\"lw\": 0,\n\"lc\": 0,\n\"cs\": [ ]\n}\n},\n\"bi\": [ ],\n\"bidt\": { }\n}--></div></td></tr></tbody></table><p><br></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(51, 51, 51);\"><strong>1. 학위수여식 행사</strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(51, 51, 51);\"><strong>&nbsp; 가.&nbsp;일&nbsp; 시 :&nbsp; 2020.8.21(금) 11:00 ~</strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(51, 51, 51);\"><strong>&nbsp;&nbsp;나. 장&nbsp;&nbsp;소 :&nbsp; 대학본부 대강당(1층)</strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(51, 51, 51);\"><strong>&nbsp; 다. 학위수여식 행사 참석대상</strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(0, 0, 0);\"><strong><span style=\"color: rgb(255, 0, 0);\">&nbsp;&nbsp;&nbsp;&nbsp; ㅇ 코로나-19 바이러스 확산 방지 및 예방을 위해 </span><span style=\"color: rgb(255, 0, 0);\">참석대상자 이외 졸업생 및 가족은 행사장 출입이 불가능함</span></strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(0, 0, 0);\"><strong><span style=\"color: rgb(255, 0, 0);\">&nbsp;&nbsp;&nbsp;&nbsp; ㅇ 행사 전, 후 대강당 출입 불가</span></strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(51, 51, 51);\"><strong>&nbsp;&nbsp;&nbsp;&nbsp; - 학부 : 대표학위수상자, 졸업생 대표인사 학생, 상장수상자</strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(51, 51, 51);\"><strong>&nbsp;&nbsp;&nbsp;&nbsp; - 석사과정 : 대표졸업생, 상장수상자</strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(51, 51, 51);\"><strong>&nbsp;&nbsp;&nbsp;&nbsp; - 박사과정 :&nbsp;대표 학위증 수상자</strong></span></p><p style=\"line-height: 1.2;\"><strong><br></strong></p><p style=\"line-height: 1.2;\"><strong><span style=\"color: rgb(9, 0, 255);\">2.&nbsp;</span><span style=\"color: rgb(9, 0, 255);\">졸업증서 : 우편으로 발송</span></strong></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(9, 0, 255);\"><strong><br></strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(9, 0, 255);\"><strong><span style=\"color: rgb(255, 0, 0);\">3.</span><span style=\"color: rgb(255, 0, 0);\">&nbsp;학위복, 학위모&nbsp;대여 : 없음</span></strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(9, 0, 255);\"><strong><span style=\"color: rgb(255, 0, 0);\"><span style=\"color: rgb(9, 0, 255);\"><span style=\"color: rgb(9, 0, 255);\"><strong><br></strong></span></span></span></strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(9, 0, 255);\"><span style=\"color: rgb(51, 51, 51);\"><strong><span style=\"color: rgb(255, 0, 0);\">4. 포토존 : 운영하지 않음</span></strong></span></span></p><p><span style=\"color: rgb(9, 0, 255);\"><span style=\"color: rgb(9, 0, 255);\"></span></span></p><p style=\"line-height: 1.2;\"><br></p><strong></strong><p style=\"line-height: 1.2;\"><span style=\"color: rgb(51, 51, 51);\"><strong>5. 기타</strong></span></p><p style=\"line-height: 1.2;\"><strong><span style=\"color: rgb(51, 51, 51);\">&nbsp; 가. 석, 박사 학위기 수령 및 학위복,학위모 대여는 별도 안내 참조</span></strong></p><p style=\"line-height: 1.2;\"><strong><span style=\"color: rgb(51, 51, 51);\">&nbsp; 나.&nbsp;</span><span style=\"color: rgb(255, 0, 0);\"><span style=\"color: rgb(255, 0, 0);\">최근 2주이내 입국자 및 발열, 호흡기질환(의심)자 교내 출입 불가</span></span></strong></p><p style=\"line-height: 1.2;\"><strong><span style=\"color: rgb(51, 51, 51);\">&nbsp; 다.</span><span style=\"color: rgb(9, 0, 255);\"><span style=\"color: rgb(255, 0, 0);\"> 개별 방문을 하여도 학위복, 학위모 대여 및 촬영이 불가능함</span></span></strong></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(9, 0, 255);\"><strong><span style=\"color: rgb(51, 51, 51);\">&nbsp; 라. 학위증(졸업증서) 수령 주소지 소속 학사행정실에 통지 바람</span></strong></span></p><p style=\"line-height: 1.2;\"><span style=\"color: rgb(9, 0, 255);\"><strong><span style=\"color: rgb(51, 51, 51);\">&nbsp; 마. 서울, 경기, 인천 등 사회적거리 2단계 지역에 거주하는 학생은 학교방문 자제 바람.&nbsp; </span><span style=\"color: rgb(51, 51, 51);\">끝.</span></strong></span></p>\n\t\t\t\t\t\n\t\t\t\t\t\n            "}

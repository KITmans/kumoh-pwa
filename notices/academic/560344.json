pan style=\"font-family: Verdana, sans-serif; font-size: 14pt;\">  </span><!--[if !supportEmptyParas]--><span style=\"font-family: Verdana, sans-serif; font-size: 14pt;\">&nbsp;</span><!--[endif]--><span style=\"font-family: Verdana, sans-serif; font-size: 14pt;\">  </span><o:p></o:p></p><p class=\"0\" style=\"line-height: 1.8;\"><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">1. </span><span style=\"font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">대상자</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">&nbsp; 가</span><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">. </span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">복수전공</span><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">: </span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-size: 14pt;\">복수전공을 이수하다가 포기하거나 부전공으로 변경하고자 하는 자</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">&nbsp; &nbsp; - </span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-size: 14pt;\">부전공으로 변경하고자 할 경우 반드시 포기사유에 </span><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">‘</span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-size: 14pt;\">부전공으로 변경</span><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">’ </span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-size: 14pt;\">기재</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">&nbsp; 나</span><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">. </span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">부전공</span><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">: </span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-size: 14pt;\">부전공을 이수하다가 포기하고자 하는 자</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">&nbsp; 다</span><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">. </span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">연계전공</span><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">: </span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-size: 14pt;\">연계전공을 이수하다가 포기하고자 하는 자</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">&nbsp; 라</span><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">. </span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">융합전공</span><span lang=\"EN-US\" style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">: </span><span style=\"text-indent: -108.5pt; font-family: Verdana, sans-serif; font-size: 14pt;\">융합전공을 이수하다가 포기하고자 하는 자</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\"><br></span></p><p class=\"0\" style=\"line-height: 1.8;\"><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">2. </span><span style=\"font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">신청기간</span><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">: </span><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">2026.05.11.(</span><span style=\"font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">월</span><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">) 09:00:01~05.15.(</span><span style=\"font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">금</span><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">) 23:59:59</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">&nbsp; ※ </span><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; font-size: 14pt;\">신청은 마감일 </span><span lang=\"EN-US\" style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">23:59:59</span><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; font-size: 14pt;\">까지 가능</span><span lang=\"EN-US\" style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">. </span><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; font-size: 14pt;\">단</span><span lang=\"EN-US\" style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">, </span><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; font-size: 14pt;\">교무과 및 학과 문의는 근무시간 내에만 가능</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\"><br></span></p><p class=\"0\" style=\"line-height: 1.8;\"><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">3. </span><span style=\"font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">신청경로</span><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">: </span><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">Onekit-</span><span style=\"font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">통합정보시스템</span><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">-</span><span style=\"font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">학적</span><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">-</span><span style=\"font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">이수과정신청및포기</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span lang=\"EN-US\" style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\"><br></span></p><p class=\"0\" style=\"line-height: 1.8;\"><span lang=\"EN-US\" style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">4. </span><span style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">신청방법</span><span lang=\"EN-US\" style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">: </span><span style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">추가이수과정 이수내역 목록에서 </span><span style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">포기할 이수과정 선택</span><span style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">→</span><span style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">포기사유 입력</span><span style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">→</span><span lang=\"EN-US\" style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">‘</span><span style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">일괄포기신청</span><span lang=\"EN-US\" style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">’ </span><span style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">클릭</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;→</span><span style=\"text-indent: -78.7pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">추가이수과정 신청 및 포기신청 목록에서 내역 확인</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">&nbsp; ※ </span><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; font-size: 14pt;\">신청기간 내에는 </span><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">포기신청 취소 가능</span><span lang=\"EN-US\" style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">(</span><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; font-size: 14pt;\">포기신청 목록에서 해당 과정 선택 후 </span><span lang=\"EN-US\" style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">‘</span><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; font-size: 14pt;\">포기신청취소</span><span lang=\"EN-US\" style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">’ </span><span style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; font-size: 14pt;\">클릭</span><span lang=\"EN-US\" style=\"text-indent: -26.2pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">)</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span lang=\"EN-US\" style=\"text-indent: -80.6pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\"><br></span></p><p class=\"0\" style=\"line-height: 1.8;\"><span lang=\"EN-US\" style=\"text-indent: -80.6pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt;\">5. </span><span style=\"text-indent: -80.6pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt;\">참고사항</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -33.1pt; font-family: Verdana, sans-serif; font-size: 14pt;\">&nbsp; 가</span><span lang=\"EN-US\" style=\"text-indent: -33.1pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">.</span><span lang=\"EN-US\" style=\"text-indent: -33.1pt; font-size: 14pt; color: rgb(255, 0, 0); font-family: Verdana, sans-serif;\"> </span><span style=\"text-indent: -33.1pt; font-family: Verdana, sans-serif; font-size: 14pt; color: rgb(0, 0, 255);\">추가이수과정 이수자로 선발되었으나 </span><span style=\"text-indent: -33.1pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">이수가 불가능할 경우</span><span lang=\"EN-US\" style=\"text-indent: -33.1pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">, </span><span style=\"text-indent: -33.1pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">반드시 포기 신청</span><span style=\"text-indent: -33.1pt; font-family: Verdana, sans-serif; font-size: 14pt; color: rgb(0, 0, 255);\">을 하여야 </span><span style=\"text-indent: -33.1pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">졸업 가능합니다</span><span lang=\"EN-US\" style=\"text-indent: -33.1pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">.</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -35.7pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">&nbsp; &nbsp; &nbsp; ※ </span><span style=\"text-indent: -35.7pt; font-family: Verdana, sans-serif; font-weight: bold; font-size: 14pt; color: rgb(0, 0, 255);\">추가이수과정 미이수 시 졸업 불가</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -34pt; font-family: Verdana, sans-serif; font-size: 14pt;\">&nbsp; 나</span><span lang=\"EN-US\" style=\"text-indent: -34pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">. </span><span style=\"text-indent: -34pt; font-family: Verdana, sans-serif; font-size: 14pt;\">추가이수과정을 포기한 경우 기 취득한 학점은 일반선택 학점으로 인정됩니다</span><span lang=\"EN-US\" style=\"text-indent: -34pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">.</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -34pt; font-family: Verdana, sans-serif; font-size: 14pt;\">&nbsp; &nbsp; &nbsp; &nbsp;단</span><span lang=\"EN-US\" style=\"text-indent: -34pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">, </span><span style=\"text-indent: -34pt; font-family: Verdana, sans-serif; font-size: 14pt;\">복수전공에서 부전공으로 변경하는 경우에는 부전공 학점으로 인정되며</span><span lang=\"EN-US\" style=\"text-indent: -34pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">,</span></p><p class=\"0\" style=\"line-height: 1.8;\"><span style=\"text-indent: -34pt; font-family: Verdana, sans-serif; font-size: 14pt;\">&nbsp; &nbsp; &nbsp; &nbsp;융합전공에 참여하고 있는 학과</span><span lang=\"EN-US\" style=\"text-indent: -34pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">(</span><span style=\"text-indent: -34pt; font-family: Verdana, sans-serif; font-size: 14pt;\">전공</span><span lang=\"EN-US\" style=\"text-indent: -34pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">)</span><span style=\"text-indent: -34pt; font-family: Verdana, sans-serif; font-size: 14pt;\">의 학생의 기 취득 학점은 해당 융합전공의 이수를 포기하더라도 전공학점으로 인정됩니다</span><span lang=\"EN-US\" style=\"text-indent: -34pt; font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">.</span></p><p class=\"0\" style=\"line-height: 1.8; margin-left: 35pt; text-indent: -35pt; font-size: 12pt;\"><span style=\"font-family: Verdana, sans-serif; font-size: 14pt;\">  </span><!--[if !supportEmptyParas]--><span style=\"font-family: Verdana, sans-serif; font-size: 14pt;\">&nbsp;</span><!--[endif]--><span style=\"font-family: Verdana, sans-serif; font-size: 14pt;\">  </span><o:p></o:p></p><p class=\"0\" style=\"line-height: 1.8; margin-left: 35pt; text-indent: -35pt; font-size: 12pt;\"><span style=\"font-family: Verdana, sans-serif; font-size: 14pt;\"><br></span></p><p class=\"0\" style=\"line-height: 1.8; text-align: center; word-break: keep-all;\"><span lang=\"EN-US\" style=\"font-family: Verdana, sans-serif; letter-spacing: 0pt; font-size: 14pt;\">2026.  4.</span></p><p class=\"0\" style=\"line-height: 1.8; text-align: center; word-break: keep-all; font-size: 12pt;\"><span style=\"font-family: Verdana, sans-serif; font-size: 14pt;\">  </span><!--[if !supportEmptyParas]--><span style=\"font-family: Verdana, sans-serif; font-size: 14pt;\">&nbsp;</span><!--[endif]--><span style=\"font-family: Verdana, sans-serif; font-size: 14pt;\">  </span><o:p></o:p></p><p class=\"0\" style=\"line-height: 1.8; text-align: center; word-break: keep-all; font-size: 12pt;\"><span style=\"font-family: Verdana, sans-serif; font-size: 14pt;\"><br></span></p><p class=\"0\" style=\"line-height: 1.8; text-align: center; word-break: keep-all;\"><span style=\"font-family: Verdana, sans-serif; font-size: 18pt;\"><b>교 무 처 장</b></span><b style=\"font-family: Gulim, 굴림, AppleGothic, sans-serif; font-size: 12pt; color: rgb(33, 33, 33);\"></b></p>\n\t\t\t\t\t\n\t\t\t\t\t\n            "}

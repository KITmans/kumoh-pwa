000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"149\" height=\"32\">\n            <p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">24학점</span></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"149\" height=\"97\" rowspan=\"3\">\n            <p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">16학점</span></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"149\" height=\"97\" rowspan=\"3\">\n            <p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">2011년 2월 졸업자부터 적용</span></p>\n            </td>\n        </tr>\n        <tr>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"149\" height=\"32\">\n            <p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">2006학년도</span></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"149\" height=\"32\">\n            <p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">18학점</span></p>\n            </td>\n        </tr>\n        <tr>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"149\" height=\"32\">\n            <p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">2005학년도 이전</span></p>\n            </td>\n            <td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"middle\" width=\"149\" height=\"32\">\n            <p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">16학점</span></p>\n            </td>\n        </tr>\n    </tbody>\n</table>\n<p></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;※ </span><span style=\"FONT-SIZE: 14pt; COLOR: #0000ff; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">편입생</span><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">은 어학교육원에서 개설한 강좌 중 학점대체인정을 받지&nbsp;않은 강좌에 대해서도 40시간 마다 2학점으로 대체 인정함</span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;☞ 예시 : </span><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">어학교육원에서 TOEIC, TOEIC Speaking을 수강</span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;(TOEIC, TOEIC Speaking은 모두 </span><span style=\"FONT-SIZE: 12pt; COLOR: #0000ff; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">학점대체 과목은 고급영어</span><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\"> 임) </span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;⇒ TOEIC은 고급영어로 2학점 학점대체(성적표)</span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 12pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;TOEIC Speaking은 외국어졸업자격인증 2학점</span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">▣ 어학교육원 학점</span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;&nbsp;- </span><span style=\"FONT-SIZE: 14pt; COLOR: #0000ff; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">2011년 2월&nbsp;졸업예정자에 한해서 8학기차 이상 학생이 겨울 방학 중 수강한 강좌도 학점대체 인정을 받을 수 있음.</span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;※ 어학교육원 수강 신청 기한 : </span><span style=\"FONT-SIZE: 14pt; COLOR: #ff0000; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">2010.12.15(수) 까지<br><span style=\"FONT-WEIGHT: bold; FONT-SIZE: 12pt; COLOR: #0000ff; LINE-HEIGHT: 150%; FONT-FAMILY: 휴먼명조,한컴돋움; LETTER-SPACING: 0.6pt\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\"><font color=\"#000000\"><br>▣&nbsp;</font></span></span><span style=\"FONT-WEIGHT: bold; FONT-SIZE: 12pt; COLOR: #0000ff; LINE-HEIGHT: 150%; FONT-FAMILY: 휴먼명조,한컴돋움; LETTER-SPACING: -1.9pt\"> <span style=\"FONT-SIZE: 14pt; COLOR: #0000ff; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\"><font size=\"3\">2011년&nbsp; 2월&nbsp; 졸업예정자&nbsp; 등은&nbsp; </font></span></span><span style=\"FONT-WEIGHT: bold; FONT-SIZE: 12pt; COLOR: #0000ff; LINE-HEIGHT: 150%; FONT-FAMILY: 휴먼명조,한컴돋움; LETTER-SPACING: -1.9pt; TEXT-DECORATION: underline\">2011. 1. 24 ～1. 31</span><span style=\"FONT-WEIGHT: bold; FONT-SIZE: 12pt; COLOR: #0000ff; LINE-HEIGHT: 150%; FONT-FAMILY: 휴먼명조,한컴돋움; LETTER-SPACING: -1.9pt\">일 </span><span style=\"FONT-WEIGHT: bold; FONT-SIZE: 12pt; COLOR: #0000ff; LINE-HEIGHT: 150%; FONT-FAMILY: 휴먼명조,한컴돋움; LETTER-SPACING: -1.3pt\">기간내에&nbsp; 각 종합학사행정실에서 졸업외국어시험 면제 신청원을 추가로 접수 받을 예정임</span><br></span></p>\n<p class=\"HStyle0\"><span style=\"FONT-SIZE: 14pt; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\"><br><font size=\"3\"></font></span></p>\n<p class=\"HStyle0\" style=\"TEXT-ALIGN: center\"><span style=\"FONT-SIZE: 20pt; COLOR: #282828; LINE-HEIGHT: 160%; FONT-FAMILY: 휴먼명조,한컴돋움\">교 무 연 구 처 장</span></p>\n\t\t\t\t\t\n\t\t\t\t\t\n            "}

 solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"center\" width=\"63\" height=\"34\"><p class=\"HStyle0\" style=\"LINE-HEIGHT: 130%; TEXT-ALIGN: center\"><span style=\"FONT-FAMILY: 휴먼명조,한컴돋움\">&nbsp;</span></p></td><td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"center\" width=\"65\" height=\"34\"><p class=\"HStyle0\" style=\"LINE-HEIGHT: 130%; TEXT-ALIGN: center\"><span style=\"FONT-FAMILY: 휴먼명조,한컴돋움\">2</span></p></td><td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"center\" width=\"92\" height=\"34\"><p class=\"HStyle0\" style=\"LINE-HEIGHT: 130%; TEXT-ALIGN: center\"><span style=\"FONT-FAMILY: 휴먼명조,한컴돋움\">학점대체표 참조</span></p></td></tr></tbody></table><p></p><p class=\"HStyle0\"><span style=\"FONT-WEIGHT: bold; FONT-FAMILY: 휴먼명조,한컴돋움\"><br></span></p><p class=\"HStyle0\"><span style=\"FONT-WEIGHT: bold; FONT-FAMILY: 휴먼명조,한컴돋움\">※ 어학성적 학점대체표</span></p><p class=\"HStyle0\"></p><table style=\"BORDER-RIGHT: medium none; BORDER-TOP: medium none; BORDER-LEFT: medium none; BORDER-BOTTOM: medium none; BORDER-COLLAPSE: collapse\" cellspacing=\"0\" cellpadding=\"0\" border=\"1\"><tbody><tr><td style=\"BORDER-RIGHT: #000000 0.4pt solid; PADDING-RIGHT: 1.4pt; BORDER-TOP: #000000 0.4pt solid; PADDING-LEFT: 1.4pt; PADDING-BOTTOM: 1.4pt; BORDER-LEFT: #000000 0.4pt solid; PADDING-TOP: 1.4pt; BORDER-BOTTOM: #000000 0.4pt solid\" valign=\"center\" width=\"125\" bgcolor=\"#ffffcc\" height=\"35\"><p class=\"HStyle0\" style=\"LINE-HEIGHT: 130%; TEXT-ALIGN: center\"><span style=\"FONT-FAMILY: 휴먼명조,한컴돋움\">TOEIC</span></p><p class=\"HStyle0\" style=\"LINE-HEIGHT: 130%; TEXT-A
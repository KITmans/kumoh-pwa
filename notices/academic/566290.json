span></p><p class=\"0\" style=\"padding: 0px; font-family: &quot;Noto Sans KR&quot;, &quot;Nanum Gothic&quot;, Helvetica, sans-serif; font-size: 1rem; line-height: 40.3px; color: rgb(33, 33, 33); word-break: keep-all; text-align: center;\"><span style=\"font-family: 굴림; font-size: 15pt;\">교 무 처 장</span></p>\n\t\t\t\t\t\n\t\t\t\t\t\n            "}

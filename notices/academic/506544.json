none;border-bottom:double black 2.25pt;border-right:none;mso-border-left-alt:\n  solid black .25pt;padding:1.4pt 5.1pt 1.4pt 5.1pt;height:8.25pt\">\n  <p class=\"MsoNormal\" align=\"center\" style=\"text-align:center;line-height:115%;\n  mso-pagination:none;text-autospace:none;vertical-align:baseline\"><span style=\"mso-bookmark:_Hlk98745578\"><b><span lang=\"EN-US\" style=\"font-size:10.0pt;\n  line-height:115%;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-font-family:\n  휴먼명조;color:black\">Doctoral Degree</span></b></span><span style=\"mso-bookmark:\n  _Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;line-height:115%;\n  font-family:&quot;함초롬바탕&quot;,serif;mso-fareast-font-family:굴림;mso-hansi-font-family:\n  굴림;mso-bidi-font-family:굴림;color:black\"><o:p></o:p></span></span></p>\n  </td>\n  \n </tr>\n <tr style=\"mso-yfti-irow:1;mso-yfti-lastrow:yes;height:22.55pt\">\n  <td width=\"124\" style=\"width:93.15pt;border-top:none;border-left:none;\n  border-bottom:solid black 2.25pt;border-right:solid black 1.0pt;mso-border-top-alt:\n  double black 2.25pt;mso-border-top-alt:double black 2.25pt;mso-border-bottom-alt:\n  solid black 2.25pt;mso-border-right-alt:solid black .25pt;padding:1.4pt 5.1pt 1.4pt 5.1pt;\n  height:22.55pt\">\n  <p class=\"MsoNormal\" align=\"center\" style=\"text-align:center;line-height:105%;\n  mso-pagination:none;text-autospace:none;vertical-align:baseline\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\n  line-height:105%;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-font-family:\n  휴먼명조;color:black\">Period of Scholarship</span></span><span style=\"mso-bookmark:\n  _Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;line-height:105%;\n  font-family:&quot;함초롬바탕&quot;,serif;mso-fareast-font-family:굴림;mso-hansi-font-family:\n  굴림;mso-bidi-font-family:굴림;color:black\"><o:p></o:p></span></span></p>\n  </td>\n  \n  <td width=\"238\" style=\"width:178.35pt;border-top:none;border-left:none;\n  border-bottom:solid black 2.25pt;border-right:solid black 1.0pt;mso-border-top-alt:\n  double black 2.25pt;mso-border-left-alt:solid black .25pt;mso-border-top-alt:\n  double 2.25pt;mso-border-left-alt:solid .25pt;mso-border-bottom-alt:solid 2.25pt;\n  mso-border-right-alt:solid .25pt;mso-border-color-alt:black;padding:1.4pt 5.1pt 1.4pt 5.1pt;\n  height:22.55pt\">\n  <p class=\"MsoNormal\" align=\"center\" style=\"text-align:center;line-height:105%;\n  mso-pagination:none;text-autospace:none;vertical-align:baseline\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\n  line-height:105%;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-font-family:\n  휴먼명조;color:black\">One year of Korean language program + Two years of degree\n  program</span></span><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;line-height:105%;font-family:&quot;함초롬바탕&quot;,serif;\n  mso-fareast-font-family:굴림;mso-hansi-font-family:굴림;mso-bidi-font-family:\n  굴림;color:black\"><o:p></o:p></span></span></p>\n  </td>\n  \n  <td width=\"238\" style=\"width:178.3pt;border:none;border-bottom:solid black 2.25pt;\n  mso-border-top-alt:double black 2.25pt;mso-border-left-alt:solid black .25pt;\n  padding:1.4pt 5.1pt 1.4pt 5.1pt;height:22.55pt\">\n  <p class=\"MsoNormal\" align=\"center\" style=\"text-align:center;line-height:105%;\n  mso-pagination:none;text-autospace:none;vertical-align:baseline\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\n  line-height:105%;font-family:&quot;Times New Roman&quot;,serif;mso-fareast-font-family:\n  휴먼명조;color:black\">One year of Korean language program + Three years of degree\n  program</span></span><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;line-height:105%;font-family:&quot;함초롬바탕&quot;,serif;\n  mso-fareast-font-family:굴림;mso-hansi-font-family:굴림;mso-bidi-font-family:\n  굴림;color:black\"><o:p></o:p></span></span></p>\n  </td>\n  \n </tr>\n</tbody></table>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\"><o:p>&nbsp;</o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\">■Applicants who have one of below\nKorean/English proficiency test score</span></span><span style=\"mso-bookmark:\n_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;\ncolor:red\">*</span></span><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#212121\">\ncan be exempted to take one year of Korean language program and will be\nconfirmed as early entrants to the degree program directly. Applicants who does\nnot have one of below Korean/English proficiency test score MUST take one year\nof Korean language program in KIT. <o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\"><o:p>&nbsp;</o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"text-align:justify;text-justify:distribute-all-lines;\nbackground:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:red\">*</span></span><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;mso-fareast-font-family:한양중고딕;color:black;\nletter-spacing:-2.4pt\">TOPIK level 3, TOEIC 750, TOEFL PBT 550, TOEFL ibt 79,\nTEPS 327, IELT 6.0</span></span><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:black\"><o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\"><o:p>&nbsp;</o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;nanum gothic&quot;;color:#212121\"><o:p>&nbsp;</o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#212121\">2.\nEligibility<o:p></o:p></span></b></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;nanum gothic&quot;;color:#212121\"><o:p>&nbsp;</o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\">Please refer to the attached\nK-GKS Application Guidelines<o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\"><o:p>&nbsp;</o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"word-break:break-hangul\"><span style=\"mso-bookmark:\n_Hlk98745578\"><b style=\"mso-bidi-font-weight:normal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif\">3. Obligation for K-GKS\nrecipients<o:p></o:p></span></b></span></p>\n\n<p class=\"MsoNormal\" style=\"word-break:break-hangul\"><span style=\"mso-bookmark:\n_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif\"><o:p>&nbsp;</o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"word-break:break-hangul\"><span style=\"mso-bookmark:\n_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif\">-\nK-GKS recipients are obligated to either find a job at local companies or\npursue higher degree at universities located in Gyeongsangbuk-do and to\nmaintain residency in Gyeongsangbuk-do for three years after one’s graduation. <o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"word-break:break-hangul\"><span style=\"mso-bookmark:\n_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif\">-\nK-GKS final nominees must attend “Gyeongbuk Global School” program before the\nstart of the semester. Gyeongbuk Global School will last two weeks in August\n2025, and is a program that introduces policy of Gyeongsangbuk-do and provides\nscholars with opportunities to experience Korean culture, laws and etc., to help\nthem study and settle in Gyeongsangbuk-do. <o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\"><o:p>&nbsp;</o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\"><o:p>&nbsp;</o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\">All required documents must be\nwritten by computer typing and send us one original document by post only (no\ne-mail application will be accepted). We don’t have online application for this\nK-GKS admission.</span></span><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;nanum gothic&quot;;color:#212121\"><o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\">For further information, please\nsee attached, visit website (</span></span><a href=\"https://eng.kumoh.ac.kr/\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif\">https://eng.kumoh.ac.kr</span></span></a><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:#212121\">) or contact K-GKS coordinator.</span></span><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;nanum gothic&quot;;color:#212121\"><o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:black\">&nbsp;</span></span><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;nanum gothic&quot;;color:#212121\"><o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"word-break:break-hangul\"><span style=\"mso-bookmark:\n_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif\">Below\nis the deadline and the address for the application. Thank you. <o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"word-break:break-hangul\"><span style=\"mso-bookmark:\n_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;\ncolor:#002060\"><o:p>&nbsp;</o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><b><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:red\">Submission Deadline:&nbsp;April 18<sup>th</sup>(Friday),\n2025<o:p></o:p></span></b></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><b><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:red\"><o:p>&nbsp;</o:p></span></b></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><b><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:red\">Submission Address:</span></b></span><span style=\"mso-bookmark:_Hlk98745578\"><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;nanum gothic&quot;;mso-bidi-font-family:Calibri;color:#212121\"><o:p></o:p></span></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><b><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:black\">[English]<o:p></o:p></span></b></span></p>\n\n<p class=\"MsoNormal\" style=\"background:white;word-break:break-hangul\"><span style=\"mso-bookmark:_Hlk98745578\"><b><span lang=\"EN-US\" style=\"font-size:10.0pt;\nfont-family:&quot;Arial&quot;,sans-serif;color:
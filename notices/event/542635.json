0); width: 34.57pt; height: 13.82pt; padding: 1.41pt 5.1pt; border-top: 0.28pt dotted rgb(0, 0, 0); border-left: none; border-right: 0.28pt solid rgb(0, 0, 0);\"><p class=\"1\"><span lang=\"EN-US\" style=\"font-size: 11pt;\">5</span></p></td><td valign=\"middle\" style=\"border-width: 0.28pt; border-style: dotted solid; border-color: rgb(0, 0, 0); width: 103.18pt; height: 13.82pt; padding: 1.41pt 5.1pt;\"><p class=\"0\" style=\"margin-left: 10px;\"><span style=\"font-size: 11pt;\"><span style=\"font-family: &quot;맑은 고딕&quot;;\">한국표준협회</span></span></p></td><td valign=\"middle\" style=\"border-width: 0.28pt; border-style: dotted solid; border-color: rgb(0, 0, 0); width: 155.14pt; height: 13.82pt; padding: 1.41pt 5.1pt;\"><p class=\"0\"><span lang=\"EN-US\" style=\"font-size: 11pt;\"><span style=\"font-family: &quot;맑은 고딕&quot;;\">KS WEB</span></span></p></td><td valign=\"middle\" style=\"border-width: 0.28pt; border-style: dotted solid; border-color: rgb(0, 0, 0); width: 105.81pt; height: 13.82pt; padding: 1.41pt 5.1pt;\"><p class=\"0\"><span style=\"word-break: keep-all;\"><span style=\"font-size: 11pt;\"><span style=\"font-family: &quot;맑은 고딕&quot;;\">국내&nbsp;</span></span><span lang=\"EN-US\" style=\"font-size: 11pt;\"><span style=\"font-family: &quot;맑은 고딕&quot;;\"><span style=\"letter-spacing: 0pt;\">DB</span></span></span></span></p></td></tr><tr><td valign=\"middle\" style=\"border-bottom: 1.7pt solid rgb(0, 0, 0); width: 34.57pt; height: 13.82pt; padding: 1.41pt 5.1pt; border-top: 0.28pt dotted rgb(0, 0, 0); border-left: none; border-right: 0.28pt solid rgb(0, 0, 0);\"><p class=\"1\"><span lang=\"EN-US\" style=\"font-size: 11pt;\">6</span></p></td><td valign=\"middle\" style=\"border-width: 0.28pt 0.28pt 1.7pt; border-style: dotted solid solid; border-color: rgb(0, 0, 0); width: 103.18pt; height: 13.82pt; padding: 1.41pt 5.1pt;\"><p class=\"0\" style=\"margin-left: 10px;\"><span style=\"font-size: 11pt;\"><span style=\"font-family: &quot;맑은 고딕&quot;;\">㈜&nbsp;</span></span><span style=\"font-size: 11pt;\"><span style=\"font-family: &quot;맑은 고딕&quot;;\">챔프스터디</span></span></p></td><td valign=\"middle\" style=\"border-width: 0.28pt 0.28pt 1.7pt; border-style: dotted solid solid; border-color: rgb(0, 0, 0); width: 155.14pt; height: 13.82pt; padding: 1.41pt 5.1pt;\"><p class=\"0\"><span style=\"font-size: 11pt;\"><span style=\"font-family: &quot;맑은 고딕&quot;;\">해커스 어학강좌</span></span></p></td><td valign=\"middle\" style=\"border-width: 0.28pt 0.28pt 1.7pt; border-style: dotted solid solid; border-color: rgb(0, 0, 0); width: 105.81pt; height: 13.82pt; padding: 1.41pt 5.1pt;\"><p class=\"0\"><span style=\"word-break: keep-all;\"><span style=\"font-size: 11pt;\"><span style=\"font-family: &quot;맑은 고딕&quot;;\">동영상 강의</span></span></span></p></td></tr></tbody></table><div class=\"hwp_editor_board_content\" data-hjsonver=\"1.0\" data-jsonlen=\"84747\" id=\"hwpEditorBoardContent\" style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp;</div><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp;</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\"><strong>&nbsp;□&nbsp;</strong><strong>행사참가 방법 및 참여자 혜택</strong></p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; ○&nbsp;<strong>오프라인</strong></p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; &nbsp; -&nbsp;학생들은 부스에서 이용교육 참여 및 실습 후 교육 스탬프 획득</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; &nbsp; -&nbsp;교육 스탬프&nbsp;5개 이상 모아&nbsp;도서관 부스에서 만족도 조사 참여하고 직원 확인 후 응모권 제출</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\"><strong>&nbsp; &nbsp; ○&nbsp;<strong>온라인</strong></strong></p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\"><strong><strong>&nbsp; &nbsp; &nbsp; &nbsp; 메타버스 접속방법: 향후 주소 추가</strong></strong></p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; &nbsp; &nbsp; 가.&nbsp;<a href=\"https://zep.us/play/8lMp7g\" target=\"_blank\" style=\"text-indent: -31.8667px;\">https://zep.us/play/8lMp7g</a>&nbsp;를&nbsp;통하여 메타버스 도서관에&nbsp;입장</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; &nbsp; &nbsp; &nbsp;*&nbsp;<strong>회원가입 필수, 캐릭터명은 학번 으로 입장 - (참여확인 및 BISKIT 점수부여를 위함)</strong></p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; &nbsp; &nbsp; 나. 학술전자정보박람회장을 방문하여 부스(학술DB)에서&nbsp;퀴즈 참여</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; &nbsp; &nbsp; 다. 4개 이상의 부스를 방문하여 퀴즈를 참여한 구성원을 대상으로&nbsp;추첨을 통해 경품지급</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp;<strong>&nbsp; &nbsp; &nbsp;* 유의사항 -&nbsp;설문조사 참여 필수 (설문조사를 하지 않거나, 4개 이상의 퀴즈를 참여하지 않은 경우 대상에서 제외)</strong></p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp;<strong>&nbsp; &nbsp; &nbsp;*<span style=\"color: rgb(0, 0, 255);\">&nbsp;온라인 참여 경품은 상품권으로 상황따라 품목 변경될 수 있음</span></strong></p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp;</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\"><strong>&nbsp; □&nbsp;</strong><strong>참여자혜택</strong></p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp;○&nbsp;학부생&nbsp;BISkit&nbsp;역량 20점&nbsp;부여(공통)</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp;○&nbsp;선착순 총&nbsp;110명에게 기념품 증정(오프라인)&nbsp;(10시30분 ~ 13시 제출자 선착순&nbsp;55명&nbsp;/ 13 ~ 16시 제출자 선착순&nbsp;55명)</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp;○&nbsp;추첨을 통한 경품 증정(오프라인,&nbsp;온라인)</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp;○&nbsp;유의사항</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; &nbsp;-&nbsp;오프라인&nbsp;경품추첨 현장 참석자에 한해&nbsp;1인&nbsp;1회 지급(현장 부재 시 재추첨)</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; &nbsp;-&nbsp;온라인 경품추첨&nbsp;1인&nbsp;1회 지급</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; &nbsp;<strong>-&nbsp;교직원은 상품을 문화상품권(기프티콘)으로&nbsp;제한함</strong></p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\"><strong>&nbsp; &nbsp; &nbsp; &nbsp; * 기타 상품 당첨 시 재추첨</strong></p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp; &nbsp; &nbsp;-&nbsp;업체 별 경품지급으로 수량 및 품목 변경될 수 있음</p><p style=\"color: rgb(0, 0, 0); font-family: &quot;Noto Sans KR&quot;; font-size: medium;\">&nbsp;</p><p style=\"text-align: center;\"><br></p><p style=\"text-align: center;\"><br></p><p><br></p>\n\t\t\t\t\t\n\t\t\t\t\t\n            "}
